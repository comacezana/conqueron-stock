# Leave DATABASE_URL unset for local dev / self-hosting (embedded Postgres, data/pgdata).
# Set it to deploy to a serverless/edge host with a real Postgres, e.g. Neon.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required whenever DATABASE_URL is set (generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# )
# SESSION_SECRET=

# Only used the very first time the database seeds. Change from the Users page after.
# ADMIN_PASSWORD=
# STORE_PASSWORD=
