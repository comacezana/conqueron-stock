# Leave DATABASE_URL unset for local dev / self-hosting (embedded Postgres, data/pgdata).
# Set it to deploy to a serverless/edge host with a real Postgres, e.g. Neon.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required whenever DATABASE_URL is set (generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# )
# SESSION_SECRET=

# Only used the very first time the database seeds. Change from the Users page after.
# ADMIN_PASSWORD=
# STORE_PASSWORD=

# Emailing monthly reports (any SMTP provider). Port 465 uses SSL, 587 uses STARTTLS.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Conqueron Stock <you@gmail.com>"

# Enables the automatic send of last month's report on the 1st (vercel.json). Any long random string.
# CRON_SECRET=
